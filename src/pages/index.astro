---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import { personJsonLd } from '../lib/jsonld';
import { SITE } from '../site';

const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const { books = [], work = [] } = home.data;
const posts = (await getPosts()).slice(0, 4);
---

<Base description={home.data.description} jsonLd={personJsonLd()}>
  <section class="hero wrap">
    <div class="rise">
      <p class="eyebrow">{SITE.title} · {SITE.location}</p>
      <h1>JJ Geewax</h1>
      <div class="lede intro"><Content /></div>
      <div class="actions">
        <a class="button primary" href="/speaking/">Speaker kit</a>
        <a class="button" href="/resume/">Résumé</a>
        <a class="button" href={`mailto:${SITE.email}`}>Get in touch</a>
      </div>
    </div>
    <ul class="affiliations rise" aria-label="Organizations">
      <li>Google DeepMind</li>
      <li>Meta</li>
      <li>Google</li>
      <li>Manning Publications</li>
      <li>Mojaloop Foundation</li>
      <li>University of Pennsylvania</li>
    </ul>
  </section>

  <section class="section wrap" aria-labelledby="books">
    <div class="section-head">
      <h2 id="books">Books</h2>
    </div>
    <div class="books">
      {
        books.map((b) => (
          <article class="book">
            <a class="cover" href={b.links[0].url} tabindex="-1" aria-hidden="true">
              <img src={b.cover} alt="" width="360" height="451" loading="lazy" decoding="async" />
            </a>
            <div>
              <p class="meta">
                {b.publisher} · {b.year}
              </p>
              <h3>
                <a href={b.links[0].url}>
                  <cite>{b.title}</cite>
                </a>
              </h3>
              <p class="blurb">{b.blurb}</p>
              <p class="book-links">
                {b.links.map((l) => (
                  <a class="arrow-link" href={l.url}>
                    {l.label}
                  </a>
                ))}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section wrap" aria-labelledby="work">
    <div class="section-head">
      <h2 id="work">Research and standards</h2>
    </div>
    <ol class="work">
      {
        work.map((w) => (
          <li>
            <span class="meta year">{w.year}</span>
            <div>
              <a class="work-title" href={w.url}>
                {w.title}
              </a>
              <p class="meta">
                {w.venue}
                {w.note && <> · {w.note}</>}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="writing">
    <div class="section-head">
      <h2 id="writing">Writing</h2>
      <a class="arrow-link" href="/writing/">All writing</a>
    </div>
    <PostList posts={posts} />
  </section>

  <section class="section wrap">
    <div class="cta">
      <div>
        <p class="eyebrow">Organizing an event?</p>
        <h2>Bios, topics and past talks, ready to paste.</h2>
      </div>
      <a class="button primary" href="/speaking/">Go to the speaker kit</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 9rem) clamp(3rem, 6vw, 4.5rem);
  }
  h1 {
    font-size: clamp(3.25rem, 2rem + 6vw, 6.5rem);
    font-weight: 450;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 1rem 0 1.75rem;
  }
  .intro {
    max-width: 42rem;
  }
  .intro :global(p) {
    margin: 0 0 1rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .affiliations {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    list-style: none;
    padding: 1.5rem 0 0;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    border-top: 1px solid var(--rule);
    font: 500 0.8125rem var(--sans);
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }
  .affiliations li {
    animation-delay: 0.3s;
  }

  /* Books */
  .books {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .book {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1.75rem;
    align-items: start;
  }
  .cover {
    display: block;
    perspective: 800px;
  }
  .cover img {
    display: block;
    width: 100%;
    border-radius: 3px 6px 6px 3px;
    box-shadow: var(--shadow);
    transform-origin: left center;
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .book:hover .cover img {
    transform: rotateY(-10deg) translateX(-2px);
    box-shadow: var(--shadow-lift);
  }
  .book h3 {
    font-size: 1.5rem;
    margin: 0.35rem 0 0.6rem;
  }
  .book h3 a {
    text-decoration: none;
  }
  cite {
    font-style: italic;
  }
  .blurb {
    margin: 0 0 1rem;
    color: var(--ink-2);
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .book-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0;
  }
  @media (max-width: 30rem) {
    .book {
      grid-template-columns: 6.5rem 1fr;
      gap: 1.25rem;
    }
  }

  /* Research */
  .work {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .work li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    column-gap: 1.5rem;
    padding: 1.1rem 0;
  }
  .work li + li {
    border-top: 1px solid var(--rule);
  }
  .year {
    padding-top: 0.3rem;
  }
  .work-title {
    font-size: 1.25rem;
    line-height: 1.35;
    text-decoration: none;
  }
  .work p {
    margin: 0.3rem 0 0;
  }
  @media (max-width: 40rem) {
    .work li {
      grid-template-columns: 1fr;
    }
  }

  /* CTA */
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: 16px;
    background: var(--bg-sunk);
    border: 1px solid var(--rule);
  }
  .cta h2 {
    margin: 0.5rem 0 0;
    font-size: clamp(1.4rem, 1.2rem + 1vw, 1.9rem);
    max-width: 30rem;
  }
</style>
