---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <div class="wrap">
    <header class="page-head rise">
      <p class="eyebrow">404</p>
      <h1>That page isn't here.</h1>
      <p class="lede">
        It may have moved when this site left Ghost. Try the <a href="/writing/">writing index</a>, the <a
          href="/speaking/">speaker kit</a
        >, or the <a href="/">home page</a>.
      </p>
    </header>
  </div>
</Base>
